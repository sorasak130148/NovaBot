# Copy to .env.local and fill in. The key stays on the server; the browser never sees it.
# Any OpenAI-compatible endpoint works. Pick one block.

# --- OpenCode Go ---
XAI_API_KEY=oc_sk_...
XAI_BASE_URL=https://opencode.ai/zen/go/v1
DEFAULT_MODEL=deepseek-v4.1-flash

# --- xAI ---
# XAI_API_KEY=xai-...
# XAI_BASE_URL=https://api.x.ai/v1
# DEFAULT_MODEL=grok-4

# --- Local Ollama ---
# XAI_API_KEY=ollama
# XAI_BASE_URL=http://localhost:11434/v1
# DEFAULT_MODEL=qwen3.5:9b-q4_K_M
